# Copy to backend/.env and replace every placeholder. Never commit the real .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://vglug:change-me@localhost:5432/vglug
# Separate database used by the automated tests (it is wiped during test runs)
TEST_DATABASE_URL=postgresql+psycopg://vglug:change-me@localhost:5432/vglug_test

# Public site origin, used for links inside emails
PUBLIC_BASE_URL=http://localhost:5173

# Set to true in production (HTTPS only cookies)
SESSION_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
# Number of trusted reverse proxies in front of the app (0 when none)
TRUST_PROXY_COUNT=0

# Initial administrator (bootstrap only; the password must be changed at first sign-in)
INITIAL_ADMIN_USERNAME=vglug
INITIAL_ADMIN_PASSWORD=vglug@123

# Local media storage (relative paths resolve against backend/). Keep it on persistent storage.
UPLOAD_FOLDER=uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200

# Rate limiting. Use a shared store such as redis://localhost:6379 when running several workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# Comments
COMMENTS_REQUIRE_APPROVAL=true
COMMENT_MAX_LENGTH=2000
COMMENT_MAX_LINKS=2

# Email subscriptions: EMAIL_BACKEND = console (logs emails, for development) | smtp | disabled
SUBSCRIPTIONS_ENABLED=true
EMAIL_BACKEND=console
EMAIL_FROM="VGLUG <updates@example.org>"
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
# starttls | ssl | none
SMTP_SECURITY=starttls
EMAIL_MAX_ATTEMPTS=5
SUBSCRIPTION_TOKEN_HOURS=48

# Optional: absolute path to frontend/dist to serve the built React app from Flask
FRONTEND_DIST=

LOG_LEVEL=INFO
